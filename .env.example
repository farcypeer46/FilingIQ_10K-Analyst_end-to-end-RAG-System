# Copy this file to .env and fill in your real values.
# .env is gitignored and must NEVER be committed.
#
#   cp .env.example .env
#   # then edit .env and paste your real key
#
# Only the generation/summarization LLM (OpenAI) needs a key. Embedding,
# reranking, the vector store, and BM25 all run locally and cost nothing —
# so a warm rebuild with cached summaries needs no key at all.

OPENAI_API_KEY=sk-your-key-here
